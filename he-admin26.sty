  \ifdefstring{\HEDocumentPart}{A}{%
    \pretocmd{\subsubsection}{\par\Needspace{6\baselineskip}}{}{}%
  }{}%
}

% Editable sources contain only semantic fields and records. All inclusion,
% human-readable labels and presentation logic stay in this package.
\ExplSyntaxOn
\prop_new:N \g_he_admin_labels_prop
\prop_new:N \g_he_admin_types_prop
\prop_new:N \g_he_admin_hints_prop
\prop_new:N \g_he_admin_values_prop
\prop_new:N \g_he_admin_names_prop
\tl_new:N \g_he_admin_rows_tl
\tl_new:N \l_he_admin_budget_rows_tl
\tl_new:N \l_he_admin_number_tl
\tl_new:N \l_he_admin_name_tl
\tl_new:N \l_he_admin_country_tl
\tl_new:N \l_he_admin_role_tl
\tl_new:N \l_he_admin_label_tl
\tl_new:N \l_he_admin_type_tl
\tl_new:N \l_he_admin_hint_tl
\bool_new:N \l_he_admin_collect_bool
\int_new:N \l_he_admin_mode_int
% 0: ordinary fields; 1: participant details; 2: budget; 3: Part B list.
\NewDocumentCommand{\HEAdminDeclareField}{m m m m}{
  \prop_gput:Nnn \g_he_admin_labels_prop {#1}{#2}
  \prop_gput:Nnn \g_he_admin_types_prop {#1}{#3}
  \prop_gput:Nnn \g_he_admin_hints_prop {#1}{#4}
}
\cs_new_protected:Npn \he_admin_literal:n #1 {
  \tl_set:Nx \l_tmpa_tl {\tl_to_str:n {#1}}
  \regex_replace_all:nnN {_}{\c{space}} \l_tmpa_tl
  \tl_use:N \l_tmpa_tl
}
\cs_new_protected:Npn \he_admin_value:nn #1#2 {
  \tl_if_blank:nTF {#2}
    {\textit{[to~be~completed]}}
    {\str_case:nnF {#1}{
      {boolean}{\he_admin_literal:n{#2}}
      {enum}{\he_admin_literal:n{#2}}
      {multiselect}{\he_admin_literal:n{#2}}
      {email}{\nolinkurl{#2}}
      {url}{\nolinkurl{#2}}
    }{#2}}
}
\cs_new_protected:Npn \he_admin_render_field:nn #1#2 {
  \prop_get:NnNTF \g_he_admin_labels_prop {#1} \l_he_admin_label_tl
    {}{\tl_set:Nn \l_he_admin_label_tl {\texttt{\detokenize{#1}}}}
  \prop_get:NnNTF \g_he_admin_types_prop {#1} \l_he_admin_type_tl
    {}{\tl_set:Nn \l_he_admin_type_tl {string}}
  \prop_get:NnNTF \g_he_admin_hints_prop {#1} \l_he_admin_hint_tl
    {}{\tl_clear:N \l_he_admin_hint_tl}
  \str_if_eq:VnTF \l_he_admin_type_tl {text}{
    \par\Needspace{4\baselineskip}
    \noindent\textbf{\tl_use:N \l_he_admin_label_tl}\par
    \tl_if_blank:VF \l_he_admin_hint_tl {
      \HEGuide{\noindent\tl_use:N \l_he_admin_hint_tl\par}
    }
    \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=black!40,
      boxrule=0.4bp,arc=0pt,left=5bp,right=5bp,top=4bp,bottom=4bp,
      before~skip=3bp,after~skip=5bp]
      \he_admin_value:nn {text}{#2}
    \end{tcolorbox}
  }{
    \par\noindent\textbf{\tl_use:N \l_he_admin_label_tl :}\enspace
    \exp_args:NV \he_admin_value:nn \l_he_admin_type_tl {#2}\par
    \tl_if_blank:VF \l_he_admin_hint_tl {
      \HEGuide{\noindent\tl_use:N \l_he_admin_hint_tl\par}
    }
  }
}
\NewDocumentCommand{\AField}{m +m}{
  \bool_if:NTF \l_he_admin_collect_bool
    {\prop_gput:Nnn \g_he_admin_values_prop {#1}{#2}}
    {\he_admin_render_field:nn {#1}{#2}}
}
\cs_new_protected:Npn \he_admin_collect:n #1 {
  \prop_gclear:N \g_he_admin_values_prop
  \group_begin:
    \bool_set_true:N \l_he_admin_collect_bool
    \RenewDocumentCommand{\section}{s o m}{}
    \RenewDocumentCommand{\subsection}{s o m}{}
    \RenewDocumentCommand{\subsubsection}{s o m}{}
    \RenewDocumentEnvironment{heguidance}{+b}{}{}
    \RenewDocumentCommand{\HEGuide}{+m}{}
    #1
  \group_end:
}
\cs_new_protected:Npn \he_admin_partner:n #1 {
  \he_admin_collect:n {#1}
  \subsection{Participant~\prop_item:Nn \g_he_admin_values_prop {participant.number}
    \texorpdfstring{\enspace---\enspace}{\space---\space}%
    \prop_item:Nn \g_he_admin_values_prop {organisation.short_name}}
  #1
}
\cs_new_protected:Npn \he_admin_budget_row:n #1 {
  \prop_item:Nn \g_he_admin_labels_prop {budget.#1} &
  \prop_get:NnNF \g_he_admin_values_prop {budget.#1} \l_tmpa_tl {\tl_clear:N \l_tmpa_tl}
  \tl_if_blank:VTF \l_tmpa_tl {\textit{[not~entered]}}{\tl_use:N \l_tmpa_tl}
  \\ \hline
}
\cs_new_protected:Npn \he_admin_budget:n #1 {
  \he_admin_collect:n {#1}
  \subsection{Participant~\prop_item:Nn \g_he_admin_values_prop {budget.participant_number}}
  \tl_clear:N \l_he_admin_budget_rows_tl
  \clist_map_inline:nn {
    personnel_eur,subcontracting_eur,travel_subsistence_eur,equipment_eur,
    other_goods_works_services_eur,internally_invoiced_eur,indirect_eur,
    total_eligible_eur,funding_rate_pct,maximum_eu_for_eligible_eur,
    requested_eu_eur,max_grant_amount_eur,income_generated_eur,
    financial_contributions_eur,own_resources_eur,total_estimated_income_eur
  }{\tl_put_right:Nn \l_he_admin_budget_rows_tl {\he_admin_budget_row:n {##1}}}
  \begin{longtable}{|L{\dimexpr\linewidth-48mm-4\tabcolsep-3\arrayrulewidth\relax}|L{48mm}|}
    \hline
    \textbf{Budget~item} & \textbf{Value} \\ \hline
    \endfirsthead
    \hline \textbf{Budget~item~(continued)} & \textbf{Value} \\ \hline
    \endhead
    \tl_use:N \l_he_admin_budget_rows_tl
  \end{longtable}
}
\cs_new_protected:Npn \he_admin_collect_list:n #1 {
  \he_admin_collect:n {#1}
  \prop_get:NnN \g_he_admin_values_prop {participant.number} \l_he_admin_number_tl
  \prop_get:NnN \g_he_admin_values_prop {organisation.legal_name} \l_he_admin_name_tl
  \prop_get:NnN \g_he_admin_values_prop {organisation.country} \l_he_admin_country_tl
  \prop_get:NnN \g_he_admin_values_prop {participant.role} \l_he_admin_role_tl
  \tl_gput_right:Nx \g_he_admin_rows_tl {
    \exp_not:N \he_admin_list_row:nnnn
    {\exp_not:V \l_he_admin_number_tl}
    {\exp_not:V \l_he_admin_name_tl}
    {\exp_not:V \l_he_admin_country_tl}
    {\exp_not:V \l_he_admin_role_tl}
  }
}
\cs_new_protected:Npn \he_admin_list_row:nnnn #1#2#3#4 {
  #1\str_if_eq:nnT {#4}{coordinator}{~(Coordinator)} &
  \tl_if_blank:nTF {#2}{\HEPlaceholder{organisation~name}}{#2} &
  \tl_if_blank:nTF {#3}{\HEPlaceholder{country}}{#3}
  \\ \hline
}
\NewDocumentEnvironment{ARecord}{m +b}{
  \str_case:nnF {#1}{
    {participant}{
      \int_case:nn {\l_he_admin_mode_int}{
        {1}{\he_admin_partner:n {#2}}
        {3}{\he_admin_collect_list:n {#2}}
      }
    }
    {budget_row}{
      \int_compare:nNnT {\l_he_admin_mode_int}={2}{\he_admin_budget:n {#2}}
    }
  }{
    \bool_if:NF \l_he_admin_collect_bool {\par\addvspace{3bp}}
    #2
    \bool_if:NF \l_he_admin_collect_bool {\par\addvspace{3bp}}
  }
}{}
\NewDocumentCommand{\HEPrintPartners}{}{
  \group_begin:
    \int_set:Nn \l_he_admin_mode_int {1}
    \input{part-a/partners/participants.tex}
  \group_end:
}
\NewDocumentCommand{\HEPrintBudget}{}{
  \group_begin:
    \int_set:Nn \l_he_admin_mode_int {2}
    \input{part-a/partners/participants.tex}
  \group_end:
}
\NewDocumentCommand{\HEPrintParticipantList}{}{
  \group_begin:
    \int_set:Nn \l_he_admin_mode_int {3}
    \tl_gclear:N \g_he_admin_rows_tl
    \input{part-a/partners/participants.tex}
    \begin{longtable}{|L{35mm}|L{\dimexpr\linewidth-60mm-6\tabcolsep-4\arrayrulewidth\relax}|L{25mm}|}
      \hline
      \textbf{Participant~No.\ *} & \textbf{Participant~organisation~name} & \textbf{Country}
      \\ \hline
      \endfirsthead
      \hline
      \textbf{Participant~No.\ *} & \textbf{Participant~organisation~name} & \textbf{Country}
      \\ \hline
      \endhead
      \tl_use:N \g_he_admin_rows_tl
    \end{longtable}
  \group_end:
}
\NewDocumentCommand{\AQuestion}{m +m m m}{
  \par\Needspace{4\baselineskip}\noindent #2\par\nobreak
  \noindent\textbf{Answer:}~\he_admin_value:nn {enum}{#3}
  \hfill\textbf{Part~B~pages:}~\tl_if_blank:nTF {#4}{\textit{[if~applicable]}}{#4}
  \par\addvspace{5bp}
}
\cs_new_protected:Npn \he_admin_declaration:nnn #1#2#3 {
  \par\Needspace{4\baselineskip}\noindent\textbf{#1.}~#2\par\nobreak
  \noindent\textbf{Confirmed:}~\he_admin_value:nn {enum}{#3}\par\addvspace{5bp}
}
\NewDocumentCommand{\ADeclaration}{m +m m}{
  \str_if_eq:nnTF {#1}{10}
    {\str_if_eq:eeT {\HEFunding}{lump-sum}{\he_admin_declaration:nnn {#1}{#2}{#3}}}
    {\he_admin_declaration:nnn {#1}{#2}{#3}}
}
\ExplSyntaxOff

