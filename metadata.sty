\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{metadata}[2026/11/26 Shared proposal metadata]
\RequirePackage{he-ria26}

% Single source of truth. These values must match the Portal's Part A.
\renewcommand{\HEProjectTitle}{[proposal title]}
\renewcommand{\HEAcronym}{[acronym]}
\renewcommand{\HECallIdentifier}{[insert call identifier]}
\renewcommand{\HECallName}{[insert call name]}
\renewcommand{\HETopicIdentifier}{[insert topic identifier]}
\renewcommand{\HECoordinator}{[coordinating organisation]}
\renewcommand{\HEDuration}{36}
\renewcommand{\HEKeywords}{[project keywords]}

% standard -> 40 pages; lump-sum -> 45 pages (2026-2027 full RIA).
% Direct LaTeX / Overleaf default. Make uses FUNDING=standard unless overridden,
% e.g. make FUNDING=lump-sum. \providecommand preserves those build overrides.
\providecommand{\HEFunding}{standard}
