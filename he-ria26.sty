% 11bp is exactly 11 physical PDF/PostScript points. The article class's
% nominal [11pt] alone gives 10.95 TeX points, which is slightly smaller.
% Standard glyph metrics and spacing: no font scaling, expansion or tracking.
\renewcommand{\normalsize}{%
  \@setfontsize\normalsize{11bp}{13.2bp}%
  \abovedisplayskip=6bp plus 2bp minus 2bp
  \belowdisplayskip=6bp plus 2bp minus 2bp
  \abovedisplayshortskip=3bp plus 1bp
  \belowdisplayshortskip=3bp plus 1bp
  \let\@listi\@listI}
\renewcommand{\small}{\@setfontsize\small{10bp}{12bp}}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize{9bp}{10.8bp}}
\linespread{1}
\normalsize
% Separate prose paragraphs with a modest first-line indent, never extra
% vertical glue. Reapply inside boxes, whose default parbox setup resets it.
\newcommand{\he@paragraphsetup}{%
  \setlength{\parindent}{1em}%
  \setlength{\parskip}{0pt}}
\he@paragraphsetup
\tcbset{before upper=\he@paragraphsetup}
\setlength{\textfloatsep}{7bp plus 2bp minus 1bp}
\setlength{\floatsep}{7bp plus 2bp minus 1bp}
\setlength{\intextsep}{7bp plus 2bp minus 1bp}
\setlength{\abovecaptionskip}{3bp}
\setlength{\belowcaptionskip}{0bp}
\setlength{\tabcolsep}{4bp}
\setlength{\arrayrulewidth}{0.4bp}
