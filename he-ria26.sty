% Guidance disappears at token level; hidden citations and labels are not run.
\NewDocumentEnvironment{heguidance}{+b}{%
  \ifhe@guidance
    \par\begingroup\color{HEGuidanceBlue}%
    \he@paragraphsetup
    #1\par\endgroup
  \fi}{}
\NewDocumentCommand{\HEGuide}{+m}{%
  \ifhe@guidance{\color{HEGuidanceBlue}#1}\fi}
\NewDocumentCommand{\HEBudget}{m}{%
  \ifhe@guidance\space{\normalfont\itshape\color{HEGuidanceBlue}[#1]}\fi}
\pdfstringdefDisableCommands{%
  \def\HEBudget#1{}%
  \def\HEGuide#1{}%
}
\NewDocumentCommand{\HECriterion}{m +m}{%
  \ifhe@guidance
    \begin{tcolorbox}[enhanced,breakable,colback=black!3,colframe=black!35,
      boxrule=0.4bp,arc=0pt,left=5bp,right=5bp,top=4bp,bottom=4bp,
      before skip=4bp,after skip=5bp,coltext=HEGuidanceBlue]
      \noindent\textbf{#1}\par #2
    \end{tcolorbox}
  \fi}
\NewDocumentCommand{\HEPlaceholder}{+m}{\textit{[#1]}}
\NewDocumentCommand{\HEParagraph}{m}{%
  \par\Needspace{3\baselineskip}\indent\textbf{#1.}\space\ignorespaces}
\newcounter{hetable}
\newcommand{\he@tablelabel}{}
\renewcommand{\thehetable}{\he@tablelabel}
\providecommand{\theHhetable}{\arabic{hetable}}
\crefname{hetable}{table}{tables}
\Crefname{hetable}{Table}{Tables}
\NewDocumentCommand{\HETableTitle}{m m}{%
  \par\Needspace{5\baselineskip}\vspace{5bp}%
  \renewcommand{\he@tablelabel}{#1}\refstepcounter{hetable}%
  \def\@currentlabelname{#2}%
  \noindent\textbf{Table #1:\quad #2}\par\nobreak\vspace{3bp}}
\NewDocumentCommand{\HECanvasCell}{m +m +m}{%
  \begin{tcolorbox}[enhanced,colback=white,colframe=HECanvasBlue,
    colbacktitle=HECanvasBlue,coltitle=white,boxrule=0.7bp,arc=0pt,
    title={#1},fonttitle=\bfseries,center title,
    left=5bp,right=5bp,top=4bp,bottom=5bp,
    before skip=0pt,after skip=0pt]
    \HEGuide{\itshape #2\par}%
    #3
  \end{tcolorbox}}

% Landscape pages keep horizontal headers and footers, as the RTF does.
% This is a real A4 landscape MediaBox, not a scaled or rotated content box.
\newenvironment{HELandscape}{%
  \clearpage\begingroup
  \setlength{\paperwidth}{297mm}\setlength{\paperheight}{210mm}%
  \ifdefined\pdfpagewidth
    \pdfpagewidth=\paperwidth\pdfpageheight=\paperheight
  \else
    \special{papersize=297mm,210mm}%
  \fi
  \setlength{\textwidth}{267mm}\setlength{\textheight}{180mm}%
  \setlength{\hsize}{\textwidth}\setlength{\linewidth}{\textwidth}%
  \setlength{\columnwidth}{\textwidth}\setlength{\vsize}{\textheight}%
  \global\@colht=\textheight\global\@colroom=\textheight
  \@floatplacement
  \global\@fpmin=\floatpagefraction\textheight
  \setlength{\headwidth}{\textwidth}%
}{%
  \clearpage\endgroup
  \ifdefined\pdfpagewidth
    \pdfpagewidth=\paperwidth\pdfpageheight=\paperheight
  \else
    \special{papersize=210mm,297mm}%
  \fi
  % The output routine globally updates these registers. Restore them globally
  % too, so the environment's outer group cannot reinstate landscape values.
  \global\@colht=\textheight\global\@colroom=\textheight
  \global\vsize=\textheight
  \@floatplacement
  \global\@fpmin=\floatpagefraction\textheight
}

% Print only references actually cited. An empty template builds without
% triggering an empty BibTeX run; adding \cite, \citet, \citep or \nocite works.
\newif\ifhe@citations
\pretocmd{\NAT@citexnum}{\global\he@citationstrue}{}{
  \PackageError{he-ria26}{Cannot initialise numeric citation tracking}{}}
\pretocmd{\NAT@citex}{\global\he@citationstrue}{}{
  \PackageError{he-ria26}{Cannot initialise citation tracking}{}}
\pretocmd{\nocite}{\global\he@citationstrue}{}{
  \PackageError{he-ria26}{Cannot initialise nocite tracking}{}}
\renewcommand{\bibfont}{\normalsize}
\setlength{\bibsep}{2bp}
\renewcommand{\bibsection}{\section*{References}}
\NewDocumentCommand{\HEPrintBibliography}{}{%
  \ifhe@citations
    \bibliographystyle{he-ria26}%
    \bibliography{bibliography}%
  \fi}
\providecommand{\doi}[1]{\href{https://doi.org/#1}{doi:\nolinkurl{#1}}}

% A machine-readable sidecar makes the PDF profile authoritative for checks.
\newwrite\he@metastream
\AtBeginDocument{%
  \he@resolveprofile
  \normalsize
  \hypersetup{pdftitle={\HEProjectTitle},pdfauthor={\HECoordinator},
    pdfsubject={Horizon Europe RIA -- Part \HEDocumentPart{} -- \HETopicIdentifier},
    pdfkeywords={\HEKeywords},pdfcreator={LaTeX with he-ria26.sty}}%
  \immediate\openout\he@metastream=\jobname.hemeta
  \ifdefstring{\HEDocumentPart}{A}{%
    \immediate\write\he@metastream{%
      {"document_part":"A","funding":"\HEFunding","page_limit":null,"guidance":\HEGuidance}}%
  }{%
    \immediate\write\he@metastream{%
      {"document_part":"B","funding":"\HEFunding","page_limit":\HEPageLimit,"guidance":\HEGuidance}}%
  }%
  \immediate\closeout\he@metastream
  \ifdefstring{\HEDocumentPart}{A}
    {\typeout{[he-ria26] Part A; funding: \HEFunding; no Part B page cap}}%
    {\typeout{[he-ria26] Funding: \HEFunding; full-document page limit: \HEPageLimit}}%
  \typeout{[he-ria26] Body: 11bp; baseline: 13.2bp; margins: 15mm}%
}
