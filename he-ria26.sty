\newcommand{\he@resolveprofile}{%
  \providecommand{\HEFunding}{standard}%
  \ifdefstring{\HEFunding}{standard}
    {\providecommand{\HEPageLimit}{40}%
     \renewcommand{\HEImplementationBudget}{12 pages}}
    {\ifdefstring{\HEFunding}{lump-sum}
