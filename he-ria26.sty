% The body retains the full 180 x 267 mm rectangle. Header and footer occupy
% the permitted margin area; they do not reduce the text height.
\fancypagestyle{horizon}{%
  \fancyhf{}
  \fancyhead[L]{\parbox[b]{\headwidth}{%
    \sffamily\fontsize{8bp}{9bp}\selectfont
    Call: \HECallIdentifier{} --- \HECallName\par
    \raggedleft\color{HEHeaderGrey}%
    \ifdefstring{\HEDocumentPart}{A}
      {Horizon Europe: Administrative drafting forms}
      {EU Grants: Application form (HE RIA and IA): V5.1 -- 22.01.2026}}}
  \fancyfoot[C]{%
    \begingroup\setlength{\fboxsep}{3bp}\setlength{\fboxrule}{0.4bp}%
    \fcolorbox{black}{HEFooterGrey}{%
      \parbox{\dimexpr\headwidth-2\fboxsep-2\fboxrule\relax}{%
        \centering\sffamily\fontsize{8.5bp}{10bp}\selectfont
        Part \HEDocumentPart{} -- Page \thepage{}%
        \ifdefstring{\HEDocumentPart}{B}{ of \HEPageLimit}{}}}%
    \endgroup}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}}
\pagestyle{horizon}

\NewDocumentCommand{\HEMakeTitle}{}{%
  \noindent\begin{minipage}{\linewidth}
    \centering\fontsize{20bp}{23bp}\selectfont\bfseries
    \HEDocumentTitle\par
    \vspace{5bp}
    \setlength{\fboxsep}{3bp}\setlength{\fboxrule}{0.4bp}%
    \fbox{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}{%
      \centering\fontsize{14bp}{16.8bp}\selectfont
      \scshape\HEProjectTitle}}%
