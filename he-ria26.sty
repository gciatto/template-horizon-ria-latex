\setlength{\LTpre}{4bp}
\setlength{\LTpost}{4bp}
\setlength{\emergencystretch}{1.5em}
\raggedbottom
\setlist{leftmargin=1.6em,topsep=3bp,itemsep=2bp,parsep=0bp,partopsep=0bp}
